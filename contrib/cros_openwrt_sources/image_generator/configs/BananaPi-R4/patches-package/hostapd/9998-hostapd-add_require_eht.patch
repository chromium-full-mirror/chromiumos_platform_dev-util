Index: hostapd-2026.02.19~53d12cd4/src/ap/ieee802_11.c
===================================================================
--- hostapd-2026.02.19~53d12cd4.orig/src/ap/ieee802_11.c
+++ hostapd-2026.02.19~53d12cd4/src/ap/ieee802_11.c
@@ -158,6 +158,12 @@ static size_t hostapd_supp_rates(struct hostapd_data *hapd, u8 *buf)
 		*pos++ = 0x80 | BSS_MEMBERSHIP_SELECTOR_HE_PHY;
 #endif /* CONFIG_IEEE80211AX */
 
+#ifdef CONFIG_IEEE80211BE
+	if (hapd->iconf->ieee80211be && hapd->iconf->require_eht) {
+		*pos++ = 0x80 | BSS_MEMBERSHIP_SELECTOR_EHT_PHY;
+	}
+#endif
+
 #ifdef CONFIG_SAE
 	if ((hapd->conf->sae_pwe == SAE_PWE_HASH_TO_ELEMENT ||
 	     hostapd_sae_pw_id_in_use(hapd->conf) == 2) &&
@@ -4690,6 +4696,7 @@ static int __check_assoc_ies(struct hostapd_data *hapd, struct sta_info *sta,
 			if (resp != WLAN_STATUS_SUCCESS)
 				goto out;
 		}
+
 	}
 #endif /* CONFIG_IEEE80211AX */
 #ifdef CONFIG_IEEE80211BE
@@ -4709,6 +4716,14 @@ static int __check_assoc_ies(struct hostapd_data *hapd, struct sta_info *sta,
 			if (resp != WLAN_STATUS_SUCCESS)
 				goto out;
 		}
+
+		if (hapd->iconf->require_eht && !(sta->flags & WLAN_STA_EHT)) {
+			hostapd_logger(hapd, sta->addr, HOSTAPD_MODULE_IEEE80211,
+				       HOSTAPD_LEVEL_INFO, "Station does not support "
+				       "mandatory EHT PHY - reject association");
+			resp = WLAN_STATUS_DENIED_EHT_NOT_SUPPORTED;
+			goto out;
+		}
 	}
 #endif /* CONFIG_IEEE80211BE */
 	check_mtk_vendor_elem(hapd, sta, elems);

