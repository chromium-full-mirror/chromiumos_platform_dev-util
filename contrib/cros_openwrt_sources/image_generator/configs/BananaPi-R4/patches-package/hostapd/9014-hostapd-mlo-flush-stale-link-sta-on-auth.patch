 	 * Keep it separate from the association's binding, which is only
 	 * established by the (Re)Association Request.
 	 */
-	if (mld_sta && auth_transaction == 1)
+	if (mld_sta && auth_transaction == 1) {
+		u8 link_id = hapd->mld_link_id;
+		const u8 *old_addr = sta->mld_info.links[link_id].peer_addr;
+
+		if (sta->added_unassoc && !is_zero_ether_addr(old_addr) &&
+		    os_memcmp(old_addr, mgmt->sa, ETH_ALEN) != 0) {
