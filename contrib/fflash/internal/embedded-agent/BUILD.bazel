load("@rules_go//go:def.bzl", "go_library")
load(":defs.bzl", "zstd_compress")

go_library(
    name = "embedded-agent",
    srcs = [
        "arch.go",
        "embed.go",
    ],
    embedsrcs = [
        "dut-agent-amd64.zst",
        "dut-agent-arm64.zst",
    ],
    importpath = "chromium.googlesource.com/chromiumos/platform/dev-util.git/contrib/fflash/internal/embedded-agent",
    visibility = ["//:__subpackages__"],
)

zstd_compress(
    name = "dut-agent-amd64_zst",
    src = "//cmd/dut-agent:dut-agent-amd64",
    out = "dut-agent-amd64.zst",
)

zstd_compress(
    name = "dut-agent-arm64_zst",
    src = "//cmd/dut-agent:dut-agent-arm64",
    out = "dut-agent-arm64.zst",
)
