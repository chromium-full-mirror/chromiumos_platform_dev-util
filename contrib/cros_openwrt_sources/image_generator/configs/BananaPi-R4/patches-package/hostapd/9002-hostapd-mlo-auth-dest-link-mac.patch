+static inline const u8 * hostapd_sta_link_addr(struct hostapd_data *hapd,
+					       struct sta_info *sta)
+{
+	if (!sta)
+		return NULL;
+
+#ifdef CONFIG_IEEE80211BE
+	if (ap_sta_is_mld(hapd, sta)) {
+		if (hapd->conf->mld_ap &&
+		    !is_zero_ether_addr(sta->mld_info.links[hapd->mld_link_id].peer_addr))
+			return sta->mld_info.links[hapd->mld_link_id].peer_addr;
+		if (!is_zero_ether_addr(sta->setup_link_addr))
+			return sta->setup_link_addr;
+	}
+#endif /* CONFIG_IEEE80211BE */
+
+	return sta->addr;
+}
