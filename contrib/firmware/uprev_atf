"""Script to uprev arm-trusted-firmware (ATF)."""

import argparse
import os
from pathlib import Path
import subprocess
import sys
import textwrap


def find_chromiumos_base():
    """Find the path to the base of the checkout (e.g., ~/chromiumos)."""
    for path in Path(__file__).resolve().parents:
        if (path / ".repo").is_dir():
            return path
    raise FileNotFoundError(
        "Unable to locate the checkout of the ChromiumOS source"
    )


def is_repo_clean():
    """Check if the repo is clean, i.e., no changes to commit."""
    changes = subprocess.run(
        ["git", "status", "--porcelain"],
        stdout=subprocess.PIPE,
        encoding="utf-8",
        check=True,
    ).stdout.rstrip()
    return not changes


def git_commit_msg(source_revision, head, merge_head, cmd):
    """Generate a merge commit message based off of relevant changes.

    Args:
        source_revision: Revision of the source branch or commit.
        head: HEAD refspec.
        merge_head: Merge head.
        cmd: String of the input command.

    Returns:
        A String containing the git commit message with the exception of the
        Signed-Off-By field and Change-ID field.
    """
    branch = subprocess.check_output(
        ["git", "rev-parse", "--abbrev-ref", source_revision],
        encoding="utf-8",
    ).rstrip()
    commits = subprocess.check_output(
        ["git", "log", "--oneline", f"{head}..{merge_head}"], encoding="utf-8"
    ).rstrip()
    num_commits = len(commits.splitlines())
    cmd = textwrap.fill(cmd, width=72)

    commit_msg_template = """
{SUBJECT}

Generated by: {COMMAND_LINE}

This brings in {NUM_COMMITS} commits:

{COMMITS}
"""
    if branch:
        subject = f"Merge branch '{branch}' (commit '{merge_head}')"
    else:
        subject = f"Merge commit '{merge_head}'"

    return commit_msg_template.format(
        SUBJECT=subject,
        COMMAND_LINE=cmd,
        NUM_COMMITS=num_commits,
        COMMITS=commits,
    )


def merge_repo(source_revision, target_branch, work_branch, cmd):
    """Merge changes from ToT into this repo's branch.

    Args:
        source_revision: Revision of source branch or commit.
        target_branch: Target branch to be merged into.
        work_branch: Local working branch to be created or switched to.
        cmd: String containing the command line

    Returns:
        Whether a new merge commit is created or not.
    """
    print("Updating remote...")
    subprocess.check_call(["git", "remote", "update"])

    # Create/reset work branch and switch to it.
    cmd_switch = [
        "git",
        "switch",
        "-C",
        work_branch,
        target_branch,
    ]
    print(f"Switching to branch {work_branch!r}")
    subprocess.check_call(cmd_switch)

    # Merge source branch to work branch.
    cmd_merge = [
        "git",
        "merge",
        "--no-ff",
        "--no-commit",
        source_revision,
    ]
    print(f'Running merge: "{" ".join(cmd_merge)}"')
    try:
        subprocess.check_call(cmd_merge)
    except subprocess.CalledProcessError:
        print("Merge conflicts! This should NOT happen.")
        # Exit gracefully so the user can resolve conflicts in the shell.
        sys.exit(1)

    # Check whether any commit is needed.
    if is_repo_clean():
        print("No changes have been found, skipping commit.")
        return False

    print("Generating commit message...")
    head = subprocess.check_output(
        ["git", "rev-parse", "--short", "HEAD"],
        encoding="utf-8",
    ).strip()
    merge_head = subprocess.check_output(
        ["git", "rev-parse", "--short", "MERGE_HEAD"],
        encoding="utf-8",
    ).strip()

    commit_msg = git_commit_msg(source_revision, head, merge_head, cmd)
    subprocess.check_call(["git", "commit", "-m", commit_msg])
    return True


def upload_repo(target_branch):
    """Upload current branch to `target_branch` on Gerrit.

    Args:
        target_branch: The remote branch to be uploaded to.
    """
    if "/" not in target_branch:
        raise ValueError(
            "Cannot determine remote from branch {target_branch!r}"
        )
    remote, branch = target_branch.split("/", maxsplit=1)
    subprocess.check_call(["git", "push", remote, f"HEAD:refs/for/{branch}"])


def main(argv):
    """Generate a merge commit from ATF upstream.

    Args:
        argv: A list of the command line arguments passed to this script.
    """
    base_path = find_chromiumos_base()
    atf_path = base_path / "src/third_party/arm-trusted-firmware"

    parser = argparse.ArgumentParser()
    parser.add_argument(
        "-b",
        "--branch",
        default="uprev-atf",
        help="Local working branch to be created and used",
    )
    parser.add_argument(
        "--upload",
        default=True,
        action=argparse.BooleanOptionalAction,
        help="Whether to upload the commit by 'repo upload' (default true)",
    )
    parser.add_argument(
        "--upstream",
        default="cros/upstream_mirror/master",
        help="ATF upstream branch or commit",
    )
    parser.add_argument(
        "--downstream", default="cros/master", help="ATF downstream branch"
    )
    args = parser.parse_args(argv[1:])

    print(f"Changing dir to {atf_path}")
    os.chdir(atf_path)
    if not is_repo_clean():
        rel_path = atf_path.relative_to(base_path)
        raise RuntimeError(
            f"Changes found in {rel_path}. Please clean up and retry."
        )

    cmd = " ".join([Path(__file__).name, *argv[1:]])
    if not merge_repo(args.upstream, args.downstream, args.branch, cmd):
        return

    if args.upload:
        upload_repo(args.downstream)
    else:
        print("\n" + "*" * 72)
        print("Done.")
        print(f"Please review the merge commit in {atf_path}.")
        print("Then, upload it by 'repo upload . --cbr --no-verify'.")
        print("*" * 72)


if __name__ == "__main__":
    main(sys.argv)
