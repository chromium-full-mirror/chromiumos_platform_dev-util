FROM python:3.8-slim-buster AS build

ARG TRADEFED_DIR
ARG METADATA_DIR
ARG ARTIFACT_DIR

# attr, unzip are for CTS specifically.
# squashfs-tools is for Uprev specifically.
RUN apt-get update \
    && apt-get install -y \
      android-sdk \
      attr \
      ca-certificates \
      cpio \
      curl \
      git \
      iproute2 \
      iputils-ping \
      openssh-client \
      python-pip \
      ssh \
      sudo \
      unzip \
      wget \
      xxd

# fetch recent Android command line tools and use sdkmanager to fetch
# required android tools such as aapt and aapt2.
RUN rm -rf /var/lib/apt/lists/* && \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-7583922_latest.zip && \
    unzip commandlinetools-linux-7583922_latest.zip && \
    mv cmdline-tools /usr/lib/android-sdk/ && \
    yes | /usr/lib/android-sdk/cmdline-tools/bin/sdkmanager --sdk_root=/usr/lib/android-sdk --licenses > /dev/null && \
    /usr/lib/android-sdk/cmdline-tools/bin/sdkmanager --sdk_root=/usr/lib/android-sdk "platforms;android-30" "build-tools;30.0.3" && \
    ln -sf /usr/lib/android-sdk/build-tools/30.0.3/aapt /usr/bin/aapt && \
    ln -sf /usr/lib/android-sdk/build-tools/30.0.3/aapt2 /usr/bin/aapt2 && \
    ln -sf /usr/lib/android-sdk/platform-tools/adb /usr/bin/adb

ENV ANDROID_HOME=/usr/lib/android-sdk

# # grab gsutil
# RUN echo \
#     "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] \
#     http://packages.cloud.google.com/apt cloud-sdk main" | \
#     tee -a /etc/apt/sources.list.d/google-cloud-sdk.list && \
