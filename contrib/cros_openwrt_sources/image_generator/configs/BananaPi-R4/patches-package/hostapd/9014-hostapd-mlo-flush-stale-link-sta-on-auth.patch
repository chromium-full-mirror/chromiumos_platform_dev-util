+				   link_id, MAC2STR(old_addr), MAC2STR(mgmt->sa));
+			hostapd_drv_sta_remove(hapd, old_addr);
+			sta->added_unassoc = 0;
+			if (sta->sae)
+				sae_set_state(sta, SAE_NOTHING, "MLD link address changed");
+		}
+
 		os_memcpy(sta->auth_link_addr, mgmt->sa, ETH_ALEN);
+	}
 
